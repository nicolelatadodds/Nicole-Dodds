# Smartsheet
SMARTSHEET_ACCESS_TOKEN=your_smartsheet_api_token_here
SMARTSHEET_SHEET_ID=1234567890123456

# Microsoft Graph / Azure AD
GRAPH_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GRAPH_CLIENT_SECRET=your_azure_app_secret_here
GRAPH_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# SharePoint / OneDrive target
# Get SHAREPOINT_DRIVE_ID via: GET https://graph.microsoft.com/v1.0/sites/{site-id}/drives
SHAREPOINT_DRIVE_ID=b!xxxxxxxxxxxxxxxxxxxx
SHAREPOINT_FILE_PATH=/Client Status/Nicole-Dodds-Status.xlsx

# Scheduler (seconds between syncs)
POLL_INTERVAL_SECONDS=300

# Local staging path for the .xlsx before upload
LOCAL_OUTPUT_PATH=output/client_status.xlsx
